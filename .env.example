# Copy this file to .env and fill in ONE provider.
# .env is git-ignored. Never put a key in app.js — the browser can read it.

PROVIDER=gemini

# --- Google Gemini ---
GEMINI_API_KEY=paste-your-key-here
GEMINI_MODEL=gemini-2.0-flash

# --- NVIDIA NIM (OpenAI-compatible) — set PROVIDER=nvidia to use ---
NVIDIA_API_KEY=
NVIDIA_MODEL=meta/llama-3.3-70b-instruct

PORT=8000
