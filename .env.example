# Copy this file to .env and fill it in. .env is git-ignored.
# Never put a key in app.js: the browser can read it.

# Which model is tried first: gemini or nvidia. The other is the backup.
PROVIDER=gemini
GEMINI_API_KEY=paste-your-key-here
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK=gemini-3.5-flash-lite
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b

# Free key from openalex.org/settings/api
OPENALEX_API_KEY=
# Crossref and Unpaywall ask for a contact address
CONTACT_EMAIL=
UNPAYWALL_EMAIL=
# Optional, not used yet
S2_API_KEY=

PORT=8000
